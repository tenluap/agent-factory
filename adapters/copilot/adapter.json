{
  "name": "copilot",
  "home": { "env": "COPILOT_HOME", "default": "~/.copilot" },
  "skill_dir": "{home}/skills/factory",
  "skills_root": "~/.agents/skills",
  "agent_dir": "{home}/agents",
  "agent_file": "factory-{role}.agent.md",
  "agent_format": "markdown",
  "fields": [["name", "factory-{role}"], ["description", "{description}"]],
  "access": {
    "read": { "tools": ["read", "search", "execute"] },
    "research": { "tools": ["read", "search", "execute", "web"] },
    "write": { "tools": ["read", "edit", "search", "execute"] }
  },
  "models": {}
}
