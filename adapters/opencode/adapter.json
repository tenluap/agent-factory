{
  "name": "opencode",
  "home": {
    "env": "XDG_CONFIG_HOME",
    "default": "~/.config"
  },
  "skill_dir": "{home}/opencode/skills/factory",
  "agent_dir": "{home}/opencode/agents",
  "agent_file": "factory-{role}.md",
  "agent_format": "markdown",
  "fields": [
    [
      "description",
      "{description}"
    ]
  ],
  "extra": {
    "mode": "subagent"
  },
  "access": {
    "read": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "write": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "models": {"deep": "claude-code/claude-opus-5-5[1m]", "standard": "openai/gpt-6.1-terra" }
}
