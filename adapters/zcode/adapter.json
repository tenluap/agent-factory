{
  "name": "zcode",
  "home": { "env": "ZCODE_HOME", "default": "~/.zcode" },
  "skill_dir": "{home}/skills/factory",
  "agent_dir": "{home}/agents",
  "agent_file": "factory-{role}.md",
  "agent_format": "markdown",
  "fields": [["name", "factory-{role}"], ["description", "{description}"]],
  "access": {
    "read": { "tools": "Read, Grep, Glob, Bash" },
    "write": { "tools": "Read, Edit, Write, Bash, Grep, Glob" }
  },
  "models": { "deep": "zai-coding-plan/glm-5.3", "standard": "zai-coding-plan/glm-5.3-flash" }
}
