#!/usr/bin/env python3
"""The factory's read-only state CLI: mechanical state work, outside the orchestrator's context.

Writes nothing. Stdlib Python 3 only. Exit 0 on success, non-zero with the
reason on stderr otherwise (1 no match, 2 no git repo, 3 ambiguous match).

Usage: factory runs [--repo <path>]           unfinished runs of the repo, JSON
       factory show <run> [--repo <path>]     resume digest for one run, JSON

<run> is a run's branch (worktree runs) or a pending file's name, with or
without the <repo-name>- prefix and .json suffix.
"""
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

LARGE = ("relay", "timeline", "ledger", "history")  # summarized, never dumped whole


def die(code, message):
    print(f"factory: {message}", file=sys.stderr)
    raise SystemExit(code)


def git(repo, *args):
    try:
        out = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    except OSError:
        die(2, "git not runnable")
    if out.returncode != 0:
        die(2, out.stderr.strip() or f"git {' '.join(args)} failed")
    return out.stdout


def main_repo(cwd):
    try:
        out = subprocess.run(
            ["git", "-C", str(cwd), "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True,
        )
    except OSError:
        die(2, "git not runnable")
    if out.returncode != 0:
        die(2, f"not a git repository: {cwd}")
    return str(Path(out.stdout.strip()).resolve().parent)


def read_state(path):
    try:
        state = json.loads(path.read_text())
    except (OSError, ValueError) as e:
        return None, str(e)
    if isinstance(state, dict):
        return state, None
    return None, "state is not a JSON object"


def parse_iso(value):
    if not isinstance(value, str):
        return None
    try:
        dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    return dt.replace(tzinfo=timezone.utc) if dt.tzinfo is None else dt


def fmt_dur(ms):
    s = max(int(ms or 0), 0) // 1000
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f"{h}h {m}m" if h else (f"{m}m {s}s" if m else f"{s}s")


def last_activity(state):
    candidates = []
    for key in ("history", "timeline"):
        entries = state.get(key)
        if isinstance(entries, list) and entries and isinstance(entries[-1], dict):
            if entries[-1].get("at"):
                candidates.append(entries[-1]["at"])
    if state.get("started_at"):
        candidates.append(state["started_at"])
    return max(candidates) if candidates else None


def rounds_of(relay):
    if not isinstance(relay, dict):
        return []
    if isinstance(relay.get("rounds"), list):
        return [r for r in relay["rounds"] if isinstance(r, dict)]
    if relay.get("questions"):  # version 1: one batch at the top of relay
        return [{"questions": relay["questions"], "answers": relay.get("answers") or {}}]
    return []


def relay_digest(relay):
    rounds = rounds_of(relay)
    if not rounds:
        return None
    last = rounds[-1]
    questions = last.get("questions") or []
    answers = last.get("answers") or {}
    unanswered = []
    for position, q in enumerate(questions, 1):
        if isinstance(q, dict):
            if q.get("id") in answers:
                continue
            entry = {"position": position, **q}
        else:  # legacy string question
            entry = {"position": position, "text": str(q)}
        unanswered.append(entry)
    return {
        "stage": relay.get("stage"),
        "rounds": len(rounds),
        "total": len(questions),
        "answered": len(questions) - len(unanswered),
        "unanswered": unanswered,
    }


def totals_sentence(state):
    start = parse_iso(state.get("started_at"))
    if not start:
        return None
    try:
        end = parse_iso(state.get("ended_at")) or datetime.now(timezone.utc)
        wall_ms = (end - start).total_seconds() * 1000
    except TypeError:
        return None
    timeline = [e for e in state.get("timeline") or [] if isinstance(e, dict)]
    closed = [e for e in timeline if isinstance(e.get("latency_ms"), (int, float))]
    human_ms = sum(e["latency_ms"] for e in closed)
    ledger = [e for e in state.get("ledger") or [] if isinstance(e, dict)]
    agent_ms = sum(e["duration_ms"] for e in ledger if isinstance(e.get("duration_ms"), (int, float)))
    overhead_ms = max(wall_ms - human_ms - agent_ms, 0)
    return (
        f"Run took {fmt_dur(wall_ms)}: {fmt_dur(human_ms)} you ({len(closed)} waits), "
        f"{fmt_dur(agent_ms)} agents ({len(ledger)} spawns), {fmt_dur(overhead_ms)} overhead."
    )


def digest(state, state_path, source):
    out = {k: v for k, v in state.items() if k not in LARGE}
    out["relay"] = relay_digest(state.get("relay"))
    timeline = [e for e in state.get("timeline") or [] if isinstance(e, dict)]
    closed = sum(1 for e in timeline if e.get("latency_ms") is not None)
    out["waits"] = {
        "total": len(timeline),
        "open": len(timeline) - closed,
        "human_ms": sum(e["latency_ms"] for e in timeline if isinstance(e.get("latency_ms"), (int, float))),
    }
    ledger = [e for e in state.get("ledger") or [] if isinstance(e, dict)]
    out["spawns"] = {
        "total": len(ledger),
        "agent_ms": sum(e["duration_ms"] for e in ledger if isinstance(e.get("duration_ms"), (int, float))),
    }
    out["history_tail"] = (state.get("history") or [])[-3:]
    out["totals_sentence"] = totals_sentence(state)
    analyze = state.get("analyze")
    if isinstance(analyze, dict) and isinstance(analyze.get("pending_clarify"), list):
        out["analyze"] = {**analyze, "pending_clarify": len(analyze["pending_clarify"])}
    out["state_path"] = str(state_path)
    out["source"] = source
    return out


def worktree_states(repo):
    for block in git(repo, "worktree", "list", "--porcelain").split("\n\n"):
        for line in block.splitlines():
            if line.startswith("worktree "):
                worktree = line[len("worktree "):]
                for path in sorted(Path(worktree).glob("specs/*/factory/state.json")):
                    yield worktree, path
                break


def pending_states(repo):
    home = Path(os.environ.get("FACTORY_HOME", "~/.factory")).expanduser()
    repo_real = os.path.realpath(repo)
    for path in sorted((home / "pending").glob("*.json")):
        state, error = read_state(path)
        if error:
            print(f"factory: skipping unreadable pending file {path}: {error}", file=sys.stderr)
            continue
        repo_field = state.get("repo")
        if repo_field and os.path.realpath(repo_field) == repo_real:
            yield path, state


def find_runs(repo):
    """Every visible copy of every run: a (state_path, state, identity, worktree)
    tuple, or a plain dict for an unreadable worktree state. A run's state rides
    along as a copy into every later worktree branched after it."""
    runs = []
    for worktree, path in worktree_states(repo):
        state, error = read_state(path)
        if error:
            runs.append({"source": "worktree", "state_path": str(path),
                         "status": "unreadable", "error": error})
            continue
        runs.append((path, state, {
            "source": "worktree",
            "branch": state.get("branch") or path.parents[1].name,
            "worktree": worktree,  # where this copy was found, not the state's recorded home
            "spec_dir": state.get("spec_dir") or f"specs/{path.parents[1].name}",
        }, worktree))
    for path, state in pending_states(repo):
        runs.append((path, state, {"source": "pending", "branch": None, "name": path.stem}, None))
    return runs


def is_authoritative(run):
    path, state, identity, worktree = run
    return bool(worktree and state.get("worktree")
                and os.path.realpath(state["worktree"]) == os.path.realpath(worktree))


def deduped(runs):
    """One entry per run: copies sharing a branch collapse onto the copy in the
    worktree the state itself names, else the first seen."""
    picked, order, out = {}, [], []
    for run in runs:
        if isinstance(run, dict):
            out.append(run)
            continue
        key = (run[2]["source"], run[2].get("branch") or run[0].stem)
        if key not in picked:
            order.append(key)
            picked[key] = run
        elif is_authoritative(run) and not is_authoritative(picked[key]):
            picked[key] = run
    return out + [picked[key] for key in order]


def cmd_runs(repo):
    entries = []
    for run in deduped(find_runs(repo)):
        if isinstance(run, dict):  # unreadable worktree state
            entries.append(run)
            continue
        path, state, identity, worktree = run
        if state.get("status") == "pr-open":
            continue
        entries.append({
            **identity,
            "stage": state.get("stage"),
            "status": state.get("status"),
            "halt_reason": state.get("halt_reason"),
            "mode": state.get("mode"),
            "feature": state.get("feature"),
            "last_activity": last_activity(state),
            "state_path": str(path),
        })
    entries.sort(key=lambda e: e.get("last_activity") or "", reverse=True)
    return {"repo": repo, "runs": entries}


def cmd_show(repo, name):
    name = name[:-5] if name.endswith(".json") else name
    matches = []
    for run in deduped(find_runs(repo)):
        if isinstance(run, dict):
            continue
        path, state, identity, worktree = run
        if identity["source"] == "worktree":
            if name in (state.get("branch"), path.parents[1].name):
                matches.append((path, state, "worktree"))
        elif name == identity["name"] or identity["name"].endswith(f"-{name}"):
            matches.append((path, state, "pending"))
    if not matches:
        all_runs = deduped(find_runs(repo))
        known = ", ".join(sorted(filter(None, (
            r[1].get("branch") or r[0].stem for r in all_runs if not isinstance(r, dict)
        )))) or "none found"
        die(1, f"no run '{name}' in {repo} (runs: {known})")
    if len(matches) > 1:
        listed = ", ".join(str(p) for p, _, _ in matches)
        die(3, f"'{name}' matches several runs: {listed}")
    path, state, source = matches[0]
    return digest(state, path, source)


def emit(result):
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except AttributeError:
        pass
    print(json.dumps(result, indent=2, ensure_ascii=False, default=str))


def main(argv):
    args = argv[1:]
    if args[:1] == ["runs"]:
        command, name, rest = "runs", None, args[1:]
    elif args[:1] == ["show"] and len(args) >= 2 and not args[1].startswith("-"):
        command, name, rest = "show", args[1], args[2:]
    else:
        raise SystemExit(__doc__.strip())
    repo = None
    rest = iter(rest)
    for flag in rest:
        if flag != "--repo":
            raise SystemExit(__doc__.strip())
        repo = next(rest, None)
        if not repo:
            raise SystemExit("--repo needs a path")
    cwd = Path(repo) if repo else Path.cwd()
    repo = main_repo(cwd)
    emit(cmd_runs(repo) if command == "runs" else cmd_show(repo, name))


if __name__ == "__main__":
    main(sys.argv)
